+def _finish_market_task(key: str, task: asyncio.Task) -> None:
+    """Libera la deduplicación y aplica una caché negativa corta tras un fallo real."""
+    if _MKT_INFLIGHT.get(key) is task:
+        _MKT_INFLIGHT.pop(key, None)
+    try:
+        result = task.result()
+    except BaseException as exc:  # también consume CancelledError para evitar warnings
+        result = None
+        logger.warning("market_reading.background_error key=%s error=%s", key, exc)
+    if not result:
+        _MKT_FAILURE_UNTIL[key] = time.monotonic() + _MKT_FAILURE_TTL
+
+
+async def defer_market_reading(master_id: str, market_block: Dict) -> Dict:
+    """Devuelve la lectura cacheada o inicia su generación sin bloquear la petición HTTP.
+
+    Estados públicos: ready (caché Mongo), pending (una única tarea en curso) y
+    unavailable (sin contexto o fallo reciente). La caché negativa evita relanzar
+    Claude en cada poll cuando el proveedor falla.
+    """
+    ctx, h, cache_key = _market_reading_material(master_id, market_block)
+    if not ctx or not h or not cache_key:
+        return {"reading": None, "status": "unavailable"}
+
+    cached = await db[_MKT_CACHE].find_one(cache_key, {"_id": 0})
+    if cached and cached.get("reading"):
+        return {"reading": cached["reading"], "status": "ready"}
+
+    key = f"{master_id}:{h}"
+    failed_until = _MKT_FAILURE_UNTIL.get(key, 0.0)
+    if failed_until > time.monotonic():
+        return {"reading": None, "status": "unavailable"}
+    _MKT_FAILURE_UNTIL.pop(key, None)
+
+    task = _MKT_INFLIGHT.get(key)
+    if task is None or task.done():
+        task = asyncio.create_task(_generate_market_reading(master_id, ctx, h))
+        _MKT_INFLIGHT[key] = task
+        task.add_done_callback(lambda done, task_key=key: _finish_market_task(task_key, done))
+        logger.info("market_reading.background_started master_id=%s ctx_hash=%s", master_id, h)
+    return {"reading": None, "status": "pending"}
+
+
+async def resolve_market_reading(master_id: str, market_block: Dict) -> Optional[str]:
+    """Compatibilidad para consumidores internos que todavía esperan la generación."""
+    ctx, h, cache_key = _market_reading_material(master_id, market_block)
+    if not ctx or not h or not cache_key:
+        return None
+    cached = await db[_MKT_CACHE].find_one(cache_key, {"_id": 0})
+    if cached and cached.get("reading"):
+        return cached["reading"]
+    return await _generate_market_reading(master_id, ctx, h)
 
 
